<UserControl x:Class="CodeScope.Presentation.Features.CreateProject.Steps.AnalyzerSettingsStep.AnalyzerSettingsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeScope.Presentation.Features.CreateProject.Steps.AnalyzerSettingsStep">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock Text="Analyzer settings"
                   FontSize="20"
                   FontWeight="DemiBold"
                   Foreground="#99C"/>

        <Button Content="General info"
                Background="#222"
                Foreground="Gray"
                Padding="10, 5"
                Grid.Row="2"
                HorizontalAlignment="Left"
                Command="{Binding GoToGeneralInfoStepCommand}"/>
        
        <Button Content="Automation"
                Background="#222"
                Foreground="#99C"
                Padding="10, 5"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Command="{Binding GoToAutomationStepCommand}"/>

    </Grid>

</UserControl>