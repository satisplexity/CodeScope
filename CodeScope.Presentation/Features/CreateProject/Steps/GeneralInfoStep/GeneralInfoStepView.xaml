<UserControl x:Class="CodeScope.Presentation.Features.CreateProject.Steps.GeneralInfoStep.GeneralInfoStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeScope.Presentation.Features.CreateProject.Steps.GeneralInfoStep">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock Text="General info"
                   FontSize="20"
                   FontWeight="DemiBold"
                   Foreground="#99C"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Root path"
                       Foreground="White"/>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                <TextBox Background="#202020"
                         Foreground="White"
                         Grid.Column="1"
                         Text="{Binding RootPath}"/>

                <Button Content="Select"
                        Background="#222"
                        Foreground="Gray"
                        Padding="10, 5"
                        Command="{Binding SelectRootPathCommand}"/>

            </Grid>

            <TextBlock Text="Name"
                       Foreground="White"/>

            <TextBox Background="#202020"
                       Foreground="White"
                       Text="{Binding ProjectName}"/>

            <TextBlock Text="Description"
                       Foreground="White"/>

            <TextBox Background="#202020"
                     Foreground="White"
                     Text="{Binding ProjectDescription}"/>


        </StackPanel>
        
        <Button Content="Analyzer settings"
                Background="#222"
                Foreground="#99C"
                Padding="10, 5"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Command="{Binding GoToAnalyzerSettingStepCommand}"/>

    </Grid>

</UserControl>