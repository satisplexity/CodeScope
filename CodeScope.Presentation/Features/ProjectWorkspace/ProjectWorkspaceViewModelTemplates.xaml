<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:snapshots="clr-namespace:CodeScope.Presentation.Features.ProjectWorkspace.Features.Snapshots"
                    xmlns:analysis="clr-namespace:CodeScope.Presentation.Features.ProjectWorkspace.Features.ProjectAnalysis"
                    xmlns:settings="clr-namespace:CodeScope.Presentation.Features.ProjectWorkspace.Features.ProjectSettings">

    <DataTemplate DataType="{x:Type snapshots:SnapshotsViewModel}">

        <snapshots:SnapshotsView/>

    </DataTemplate>

    <DataTemplate DataType="{x:Type analysis:ProjectAnalysisViewModel}">

        <analysis:ProjectAnalysisView/>

    </DataTemplate>

    <DataTemplate DataType="{x:Type settings:ProjectSettingsViewModel}">

        <settings:ProjectSettingsView/>

    </DataTemplate>
    
</ResourceDictionary>