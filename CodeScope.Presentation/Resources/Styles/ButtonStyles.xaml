<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style xaml:Key="RoundedButton"
           TargetType="{xaml:Type Button}">

        <Setter Property="Foreground"
                Value="#CFCDCF"/>

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="Background"
                Value="#000000"/>

        <Setter Property="Padding"
                Value="25, 15"/>

        <Setter Property="FontFamily"
                Value="{StaticResource Manrope}"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{xaml:Type Button}">

                    <Border xaml:Name="MainBorder"
                            Background="#232323"
                            CornerRadius="20"
                            BorderThickness="2"
                            HorizontalAlignment="Center">
                        <Border.BorderBrush>

                            <LinearGradientBrush StartPoint="0.5, 0"
                                                 EndPoint="0.5, 1">

                                <GradientStop xaml:Name="GradientStop_Top"
                                              Color="#2C2C2C"
                                              Offset="0"/>

                                <GradientStop xaml:Name="GradientStop_Bottom"
                                              Color="#171717"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Grid HorizontalAlignment="Center">

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"/>

                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetName="MainBorder"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        From="#232323"
                                                        To="#2C2C2C"
                                                        Duration="0:0:0:0.1"/>

                                        <ColorAnimation Storyboard.TargetName="GradientStop_Top"
                                                        Storyboard.TargetProperty="Color"
                                                        From="#2C2C2C"
                                                        To="#383838"
                                                        Duration="0:0:0:0.1"/>

                                        <ColorAnimation Storyboard.TargetName="GradientStop_Bottom"
                                                        Storyboard.TargetProperty="Color"
                                                        From="#171717"
                                                        To="#1F1F1F"
                                                        Duration="0:0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetName="MainBorder"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        From="#2C2C2C"
                                                        To="#232323"
                                                        Duration="0:0:0:0.1"/>

                                        <ColorAnimation Storyboard.TargetName="GradientStop_Top"
                                                        Storyboard.TargetProperty="Color"
                                                        From="#383838"
                                                        To="#2C2C2C"
                                                        Duration="0:0:0:0.1"/>

                                        <ColorAnimation Storyboard.TargetName="GradientStop_Bottom"
                                                        Storyboard.TargetProperty="Color"
                                                        From="#1F1F1F"
                                                        To="#171717"
                                                        Duration="0:0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>

        <Style.Triggers>
        
            <Trigger Property="IsEnabled"
                     Value="True">
                <Trigger.EnterActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            From="#7000"
                                            To="#0000"
                                            Duration="0:0:0.2"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.EnterActions>
                <Trigger.ExitActions>

                    <BeginStoryboard>

                        <Storyboard>

                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            From="#0000"
                                            To="#7000"
                                            Duration="0:0:0:0.1"/>

                        </Storyboard>
                        
                    </BeginStoryboard>
                    
                </Trigger.ExitActions>
            </Trigger>
            
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>