<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style xaml:Key="ProjectsListBox"
           TargetType="{xaml:Type ListBox}">

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{xaml:Type ListBox}">

                    <Border CornerRadius="20"
                            Background="#222"
                            Margin="5"
                            BorderBrush="#252525"
                            BorderThickness="2">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <ItemsPresenter/>

                        </ScrollViewer>
                        
                    </Border>
                    
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
        
    </Style>
    
</ResourceDictionary>