<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style xaml:Key="BaseTextBlock"
           TargetType="{xaml:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource Manrope}"/>

        <Setter Property="Foreground"
                Value="#CDCDCF"/>

    </Style>
    
    <Style xaml:Key="PageHeader"
           TargetType="{xaml:Type TextBlock}"
           BasedOn="{StaticResource BaseTextBlock}">

        <Setter Property="FontSize"
                Value="40"/>

        <Setter Property="Margin"
                Value="20"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

    </Style>

    <Style xaml:Key="ButtonText"
           TargetType="{xaml:Type TextBlock}"
           BasedOn="{StaticResource BaseTextBlock}">

        <Setter Property="FontSize"
                Value="22"/>

        <Setter Property="FontWeight"
                Value="Medium"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

        <Setter Property="Margin"
                Value="5"/>

    </Style>

    <Style xaml:Key="CardHeader"
           TargetType="{xaml:Type TextBlock}"
           BasedOn="{StaticResource BaseTextBlock}">

        <Setter Property="FontSize"
                Value="26"/>

        <Setter Property="FontWeight"
                Value="Medium"/>

        <Setter Property="Margin"
                Value="10"/>

        <Setter Property="HorizontalAlignment"
                Value="Left"/>

    </Style>

    <Style xaml:Key="SecondaryCardHeader"
           TargetType="{xaml:Type TextBlock}"
           BasedOn="{StaticResource BaseTextBlock}">

        <Setter Property="FontSize"
                Value="22"/>

        <Setter Property="FontWeight"
                Value="Normal"/>

        <Setter Property="Margin"
                Value="10, 5"/>

        <Setter Property="HorizontalAlignment"
                Value="Left"/>

        <Setter Property="Opacity"
                Value="0.7"/>

    </Style>
    
</ResourceDictionary>