<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:CodeScope.Presentation.Views"
                    xmlns:viewModels="clr-namespace:CodeScope.Presentation.ViewModels">

    <DataTemplate DataType="{xaml:Type viewModels:ProjectsViewModel}">

        <views:ProjectsView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type viewModels:CreateProjectViewModel}">

        <views:CreateProjectView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type viewModels:ProjectOverviewViewModel}">

        <views:ProjectOverviewView/>

    </DataTemplate>

    <DataTemplate DataType="{xaml:Type viewModels:SnapshotsViewModel}">

        <views:SnapshotsView/>

    </DataTemplate>
    
</ResourceDictionary>