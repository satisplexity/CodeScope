<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CodeScope.Presentation.UI.Controls.ActionButton">

    <Style TargetType="{x:Type c:ActionButton}">

        <Setter Property="Background"
                Value="{StaticResource SurfaceNormalBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource DefaultNormalBrush}"/>

        <Setter Property="Padding"
                Value="20, 10"/>

        <Setter Property="Margin"
                Value="7, 15"/>

        <Setter Property="Opacity"
                Value="0.7"/>

        <Setter Property="RenderTransformOrigin"
                Value="0.5, 0.5"/>

        <Setter Property="RenderTransform">

            <Setter.Value>

                <ScaleTransform ScaleX="1"
                                ScaleY="1"/>

            </Setter.Value>
            
        </Setter>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type c:ActionButton}">

                    <Border CornerRadius="20"
                            Background="{TemplateBinding Background}"
                            BorderThickness="2">

                        <Border.BorderBrush>

                            <LinearGradientBrush StartPoint="0.5, 0"
                                                 EndPoint="0.5, 1">

                                <GradientStop x:Name="TopBorderColor"
                                              Color="{DynamicResource SurfaceBorderTopColor}"
                                              Offset="0"/>

                                <GradientStop x:Name="BottomBorderColor"
                                              Color="{DynamicResource SurfaceBorderBottomColor}"
                                              Offset="1"/>

                            </LinearGradientBrush>
                            
                        </Border.BorderBrush>

                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}">

                            <Path Data="{TemplateBinding IconData}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform"/>

                            <TextBlock Style="{StaticResource ButtonText}"
                                       Text="{TemplateBinding Text}"
                                       Margin="10, 0, 0, 0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            
                        </StackPanel>
                       
                    </Border>

                    <ControlTemplate.Triggers>

                        <!--#region STARTUP SETTINGS -->
                        
                        <Trigger Property="Text"
                                 Value="">

                            <Setter Property="Padding"
                                    Value="10, 10"/>

                        </Trigger>

                        <Trigger Property="IconData"
                                 Value="">

                            <Setter Property="Padding"
                                    Value="10, 10"/>

                        </Trigger>

                        <Trigger Property="ActionType"
                                 Value="Primary">

                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryNormalBrush}"/>

                        </Trigger>
                        
                        <!--#endregion-->
                        
                        <!-- DEFAULT -->

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition Property="IsMouseOver"
                                           Value="True"/>

                                <Condition Property="ActionType"
                                           Value="Default"/>

                            </MultiTrigger.Conditions>

                            <MultiTrigger.EnterActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseEnterAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource DefaultHoverColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.EnterActions>

                            <MultiTrigger.ExitActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseLeaveAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource DefaultNormalColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.ExitActions>

                        </MultiTrigger>
                        
                        <!-- PRIMARY -->

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition Property="IsMouseOver"
                                           Value="True"/>

                                <Condition Property="ActionType"
                                           Value="Primary"/>

                            </MultiTrigger.Conditions>

                            <MultiTrigger.EnterActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseEnterAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource PrimaryHoverColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>

                            </MultiTrigger.EnterActions>

                            <MultiTrigger.ExitActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseLeaveAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource PrimaryNormalColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.ExitActions>

                        </MultiTrigger>
                        
                        <!-- SUCCES -->

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition Property="IsMouseOver"
                                           Value="True"/>

                                <Condition Property="ActionType"
                                           Value="Success"/>

                            </MultiTrigger.Conditions>

                            <MultiTrigger.EnterActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseEnterAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource SuccessHoverColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.EnterActions>

                            <MultiTrigger.ExitActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseLeaveAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource DefaultNormalColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.ExitActions>
                            
                        </MultiTrigger>
                        
                        <!-- DANGER -->

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition Property="IsMouseOver"
                                           Value="True"/>

                                <Condition Property="ActionType"
                                           Value="Danger"/>

                            </MultiTrigger.Conditions>
                            
                            <MultiTrigger.EnterActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseEnterAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource DangerHoverColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </MultiTrigger.EnterActions>

                            <MultiTrigger.ExitActions>

                                <BeginStoryboard Storyboard="{StaticResource OpacityMouseLeaveAnimation}"/>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color"
                                                        To="{StaticResource DefaultNormalColor}"
                                                        Duration="0:0:0.1"/>

                                    </Storyboard>

                                </BeginStoryboard>
                                
                            </MultiTrigger.ExitActions>
                            
                        </MultiTrigger>

                        <EventTrigger RoutedEvent="Click">

                            <BeginStoryboard Storyboard="{StaticResource ClickAnimation}"/>

                        </EventTrigger>
                        
                </ControlTemplate.Triggers>
                    
                </ControlTemplate>

            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>