<UserControl xaml:Class="CodeScope.Presentation.Views.CreateProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeScope.Presentation.Views">
    
    <Grid Style="{StaticResource AnimatedPageStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button Style="{StaticResource RoundedButton}"
                Margin="10"
                Command="{Binding HideCreateProjectCommand}"
                HorizontalAlignment="Left">

            <StackPanel>

                <TextBlock Style="{StaticResource ButtonText}"
                           Text="Go back"/>

            </StackPanel>
            
        </Button>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Name"
                       Foreground="White"
                       Style="{StaticResource CardHeader}"
                       Margin="10, 0, 0, -5"/>

            <TextBox Text="{Binding ProjectName}"
                     Style="{StaticResource ModernTextBox}"
                     Margin="10"/>

            <TextBlock Text="Description"
                       Style="{StaticResource CardHeader}"
                       Foreground="White"
                       Margin="10, 0, 0, -5"/>

            <TextBox Text="{Binding ProjectDescription}"
                     Style="{StaticResource ModernTextBox}"
                     Margin="10"/>

            <Button Style="{StaticResource RoundedButton}"
                    Margin="10"
                    Command="{Binding CreateProjectCommand}"
                    HorizontalAlignment="Right">

                <StackPanel>

                    <TextBlock Style="{StaticResource ButtonText}"
                               Text="Create project"/>

                </StackPanel>
                
            </Button>

        </StackPanel>
        
    </Grid>
    
</UserControl>
