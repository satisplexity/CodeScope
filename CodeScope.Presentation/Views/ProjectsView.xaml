<UserControl xaml:Class="CodeScope.Presentation.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeScope.Presentation.Views">
    
    <Grid Background="#222">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageHeader}"
                   Text="Get started"/>
        
        <ListBox ItemsSource="{Binding Projects}"
                 Grid.Row="1"
                 SelectedItem="{Binding SelectedProject}">

            <ListBox.ItemTemplate>
                
                <DataTemplate>

                    <Border Margin="5"
                            Padding="10"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#222"
                                       Text="{Binding Name}"/>

                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="#222"
                                Text="{Binding RootPath}"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
        
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Grid.Row="2">
            
            <Button Style="{StaticResource RoundedButton}"
                    Margin="20"
                    Content="Create project"
                    Command="{Binding CreateProjectCommand}"/>

            <Button Style="{StaticResource RoundedButton}"
                    Margin="20"
                    Content="Delete project"
                    Command="{Binding DeleteProjectCommand}"/>

        </StackPanel>
        
        
        

    </Grid>
</UserControl>