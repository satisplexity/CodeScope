<Window xaml:Class="CodeScope.Presentation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeScope.Presentation.Views.Windows"
        xmlns:viewModels="clr-namespace:CodeScope.Presentation.ViewModels"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource RoundedWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="#1B1B1C"
                CornerRadius="20, 20, 0, 0">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource ButtonText}"
                           Text="CodeScope"/>
                
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    
                    <Button Style="{StaticResource RoundedButton}"
                            Content="_"
                            Click="MinimizeButton_Click"/>

                    <Button Style="{StaticResource RoundedButton}"
                            Content="☐"
                            Click="MaximizeButton_Click"/>
                    
                    <Button Style="{StaticResource RoundedButton}"
                            Content="✕"
                            Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>
        </Border>
        
        
        
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentViewModel}">

            </ContentControl>

            <Grid Visibility="{Binding IsOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#C111">

                <Border Background="#222"
                    Margin="100"
                    CornerRadius="20"
                    Padding="10">

                    <ContentControl Content="{Binding OverlayViewModel}"/>

                </Border>

            </Grid>
        </Grid>

    </Grid>

</Window>