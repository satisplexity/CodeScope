<Window xaml:Class="CodeScope.Presentation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeScope.Presentation.Views.Windows"
        xmlns:viewModels="clr-namespace:CodeScope.Presentation.ViewModels"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource RoundedWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="#1B1B1C"
                CornerRadius="19, 19, 0, 0">
            
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource ButtonText}"
                           Text="CodeScope"
                           Margin="10, 0"/>
                
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Style="{StaticResource RoundButton}"
                            Click="MinimizeButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Minimize}"/>

                    </Button>

                    <Button Style="{StaticResource RoundButton}"
                            Click="MaximizeButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Maximize}"/>

                    </Button>

                    <Button Style="{StaticResource RoundButton}"
                            Click="CloseButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Close}"/>

                    </Button>

            </StackPanel>

        </Grid>
        </Border>
        
        
        
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentViewModel}">

            </ContentControl>

            <Grid Visibility="{Binding IsOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#C111">

                <Border Background="#222"
                    Margin="100"
                    CornerRadius="20"
                    Padding="10">

                    <ContentControl Content="{Binding OverlayViewModel}"/>

                </Border>

            </Grid>
        </Grid>

    </Grid>

</Window>