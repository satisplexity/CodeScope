<Window xaml:Class="CodeScope.Presentation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeScope.Presentation.Views.Windows"
        xmlns:viewModels="clr-namespace:CodeScope.Presentation.ViewModels"
        Title="CodeScope"
        Height="900"
        Width="1200">

    <Grid>
        
        <ContentControl Content="{Binding CurrentViewModel}"/>

        <Grid Visibility="{Binding IsOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Background="#A111">

                <ContentControl Content="{Binding OverlayViewModel}"/>

            </Border>

        </Grid>
        
    </Grid>
    
</Window>