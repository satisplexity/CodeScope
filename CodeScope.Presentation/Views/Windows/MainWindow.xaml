<Window xaml:Class="CodeScope.Presentation.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeScope.Presentation.Views.Windows"
        xmlns:viewModels="clr-namespace:CodeScope.Presentation.ViewModels"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource RoundedWindow}">

    <Window.Resources>

        <BackEase xaml:Key="TransitionEasingIn"
                  Amplitude="0.5"
                  EasingMode="EaseIn"/>

        <BackEase xaml:Key="TransitionEasingOut"
                  Amplitude="0.5"
                  EasingMode="EaseOut"/>

    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="#1B1B1C"
                CornerRadius="19, 19, 0, 0">
            
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource ButtonText}"
                           Text="CodeScope"
                           Margin="10, 0"/>
                
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Style="{StaticResource RoundButton}"
                            Click="MinimizeButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Minimize}"/>

                    </Button>

                    <Button Style="{StaticResource RoundButton}"
                            Click="MaximizeButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Maximize}"/>

                    </Button>

                    <Button Style="{StaticResource RoundButton}"
                            Click="CloseButton_Click">

                        <Path Style="{StaticResource InterfaceIcon_TitleBar_Close}"/>

                    </Button>

            </StackPanel>

        </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            
            <ContentControl Content="{Binding CurrentViewModel}">
                
                <ContentControl.Style>

                    <Style TargetType="ContentControl">

                        <Setter Property="RenderTransformOrigin"
                                Value="0.5, 0.5"/>

                        <Setter Property="RenderTransform">

                            <Setter.Value>

                                <ScaleTransform ScaleX="1"
                                                ScaleY="1"/>

                            </Setter.Value>
                            
                        </Setter>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding TransitionState}"
                                         Value="FadeOut">

                                <DataTrigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0.3"
                                                             Duration="0:0:4"/>

                                            <DoubleAnimation Storyboard.TargetProperty="(ContentControl.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1"
                                                             To="0.8"
                                                             Duration="0:0:4"
                                                             EasingFunction="{StaticResource TransitionEasingIn}"/>

                                            <DoubleAnimation Storyboard.TargetProperty="(ContentControl.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1"
                                                             To="0.8"
                                                             Duration="0:0:4"
                                                             EasingFunction="{StaticResource TransitionEasingIn}"/>

                                        </Storyboard>
                                        
                                    </BeginStoryboard>
                                    
                                </DataTrigger.EnterActions>
                                
                            </DataTrigger>

                            <DataTrigger Binding="{Binding TransitionState}"
                                         Value="FadeIn">

                                <DataTrigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.3"
                                                             To="1"
                                                             Duration="0:0:0.2"/>

                                            <DoubleAnimation Storyboard.TargetProperty="(ContentControl.RenderTransform).(ScaleTransform.ScaleX)"
                 From="0.8"
                 To="1"
                 Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource TransitionEasingOut}"/>

                                            <DoubleAnimation Storyboard.TargetProperty="(ContentControl.RenderTransform).(ScaleTransform.ScaleY)"
                 From="0.8"
                 To="1"
                 Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource TransitionEasingOut}"/>

                                        </Storyboard>
                                        
                                    </BeginStoryboard>
                                    
                                </DataTrigger.EnterActions>

                            </DataTrigger>

                        </Style.Triggers>
                        
                    </Style>
                    
                </ContentControl.Style>
                
            </ContentControl>
            
        </Grid>

    </Grid>

</Window>